# 复制为 .env 或在系统环境变量中设置（不要提交 .env）

# 网关绑定地址与端口
# SERVER_HOST=0.0.0.0
# SERVER_PORT=23655

# 必需配置，Claw 节点连接的 WebSocket 桥接地址
# WS_TUNNEL_URL=ws://your-domain.com:23655/ws

# 本机 OpenAI 兼容 /v1 的 Bearer 密钥（客户端 api_key）；不设则不对中转鉴权
# 健康检查也使用此密钥测试 API 响应
# MIMO_RELAY_OPENAI_KEY=sk-your-random-secret-here

# WebUI 登录口令；不设则不启用 WebUI/API 管理面登录
# MIMO_WEBUI_USERNAME=admin
# MIMO_WEBUI_PASSWORD=change-me

# WebUI 会话签名密钥；不设时默认退化为使用上面的密码参与签名
# MIMO_WEBUI_SECRET=replace-with-a-long-random-string

# WebUI 会话有效期（秒），默认 43200，即 12 小时
# MIMO_WEBUI_SESSION_TTL_SECONDS=43200

# 仅在 HTTPS 反代后建议开启
# MIMO_WEBUI_COOKIE_SECURE=false

# 节点冷却参数（可选；默认值已是合理推荐）
# 单节点返回 401 时的临时跳过时长（秒），到期自动归队
# MIMO_NODE_401_COOLDOWN_SECONDS=30
# 同一节点累计冷却次数达到该阈值时，判定为坏号 → 主动断开 + 优先按 uid 单账号定向重建
# （仅断开该坏号对应的节点连接，不触发容器销毁或重建）。
# 设 0 = 关闭升级策略，仅冷却不断开。
# MIMO_NODE_COOLDOWN_REBUILD_THRESHOLD=3

# 代理配置（仅用于创建/销毁 Claw 容器时的请求，不影响客户端 API 转发）
# 支持 HTTP / HTTPS / SOCKS5 代理，留空则不使用代理
# 格式示例：
#   无密码: http://1.2.3.4:7890  或  socks5://1.2.3.4:1080
#   有密码: http://user:pass@1.2.3.4:7890  或  socks5://user:pass@1.2.3.4:1080
# MIMO_PROXY_URL=

# 携趣 IP 短效代理 API（可选；优先级高于 MIMO_PROXY_URL）
# 配置后，每次创建 / 销毁 mimo-claw 前会实时拉一条 HTTP 短效代理（≈30 秒）使用，用完即丢
# 也可以在 WebUI 「携趣 IP 短效代理」卡片里填入并热加载
# MIMO_XIEQU_API_URL=http://api.xiequ.cn/VAD/GetIp.aspx?act=...&num=1&...


# ----------------- 持久化文件位置（仅在自定义部署路径时需要） -----------------
# 默认情况下：
#   - 直接 `python main.py` 跑：所有 JSON 落在仓库根目录（与历史版本一致）
#   - Docker / docker-compose 跑：Dockerfile 已把这几个环境变量都指向 /app/data/，
#     和 ./data 卷一起挂出，保证「代理配置 / 携趣 IP 短效代理 / WebUI 添加的
#     AI API Key / 账号禁用列表 / 用量统计 SQLite」在容器删除重建后不会丢失。
# 仅当你想换一个自定义路径（比如挂到外部存储）时才需要在 .env 里覆盖。
# MIMO_PROXY_CONFIG_PATH=/app/data/proxy_config.json
# MIMO_XIEQU_CONFIG_PATH=/app/data/xiequ_config.json
# MIMO_AI_KEYS_PATH=/app/data/api_keys.json
# MIMO_DISABLED_ACCOUNTS_PATH=/app/data/disabled_accounts.json
# 用量统计 SQLite + 内存快照 + 单进程锁，默认也在 /app/data/ 下：
# MIMO_METRICS_DB_PATH=/app/data/gateway_metrics.db
# MIMO_METRICS_SNAPSHOT_PATH=/app/data/gateway_snapshot.json
# MIMO_PROCESS_LOCK_PATH=/app/data/mimo2api.lock
